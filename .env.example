# Application
APP_ENV=development
APP_NAME=Chowkidar
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Production example (public URLs only):
# API_URL=https://chowkidar-api.onrender.com
# WEB_URL=https://ch0wkidar.netlify.app
# NEXT_PUBLIC_API_URL=https://chowkidar-api.onrender.com
# CORS_ORIGINS=https://ch0wkidar.netlify.app,https://chowkidar-wheat.vercel.app
#
# WEB_URL is the canonical primary origin, not a list. CORS_ORIGINS accepts a
# comma-separated list of exact origins (no trailing slash, path, or "*").
#
# This file is tracked. Never put a real database URI/password,
# Supabase service-role key, JWT secret, or provider key here.

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://chowkidar:chowkidar@localhost:5432/chowkidar
TEST_DATABASE_URL=postgresql+psycopg://chowkidar:chowkidar@localhost:5432/chowkidar_test

# Auth
AUTH_MODE=dev
DEV_JWT_SECRET=replace-with-a-random-64-hex-string
DEMO_MODE=true
SUPABASE_URL=
# Legacy anon/service_role JWTs or the new sb_publishable_*/sb_secret_* keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy projects that still sign access tokens with HS256.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=chowkidar-documents
SUPABASE_AUTH_TIMEOUT_SECONDS=15

# Production path (set these in Render/Netlify/Vercel, never commit real values):
# AUTH_MODE=supabase
# DEMO_MODE=false
# STORAGE_BACKEND=database   # hosted default; supabase is optional
# REPORT_STORAGE_BUCKET=chowkidar-reports
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
MUTATION_RATE_LIMIT_PER_MINUTE=30

# AI and ingestion modes
# mock = deterministic only; live = require live path; hybrid = live with fixture fallback.
LLM_MODE=mock
DATA_MODE=fixture
EMBEDDING_MODE=mock
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_FLASH_MODEL=gemini/gemini-3.5-flash
GEMINI_PRO_MODEL=gemini/gemini-3.5-flash
GROQ_MODEL=groq/openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/qwen2.5:7b

# Live connectors (GDELT + US Federal Register are key-free)
LIVE_CONNECTOR_TIMEOUT_SECONDS=25
LIVE_CONNECTOR_MAX_RECORDS=10
# LIVE_CONNECTOR_USER_AGENT=Chowkidar/0.1 (compliance-risk pilot)

# Pipeline bounds
PIPELINE_MAX_SIGNALS=20
PIPELINE_LIVE_MAX_SIGNALS=6
PIPELINE_MAX_REPAIR_ATTEMPTS=1

# Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chowkidar-dev
NEO4J_DATABASE=neo4j

# Internal automation
INTERNAL_API_KEY=replace-with-a-random-internal-key
# The in-process scheduler is the supported ingestion path. n8n is optional.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_RUN_ON_START=false
N8N_API_URL=http://localhost:5678

# Observability and analytics
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Storage and reports
STORAGE_BACKEND=local   # local | database | supabase
REPORT_STORAGE_BUCKET=chowkidar-reports
LOCAL_STORAGE_DIR=./storage
REPORT_STORAGE_DIR=./storage/reports
UPLOAD_STORAGE_DIR=./storage/uploads

# Read-only MCP server (optional)
CHOWKIDAR_API_URL=http://127.0.0.1:8000
CHOWKIDAR_DEMO_ROLE=analyst
CHOWKIDAR_MCP_TOKEN=
