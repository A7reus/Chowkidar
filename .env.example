# Application
APP_ENV=development
APP_NAME=Chowkidar
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Production example (public URLs only):
# API_URL=https://chowkidar-api.onrender.com
# WEB_URL=https://chowkidar-wheat.vercel.app
# NEXT_PUBLIC_API_URL=https://chowkidar-api.onrender.com
# CORS_ORIGINS=https://chowkidar-wheat.vercel.app
# Web fallback (if the Render web service is synced):
# WEB_URL=https://chowkidar-web.onrender.com
#
# This file is tracked. Never put a real database URI/password,
# Supabase service-role key, JWT secret, or provider key here.

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://chowkidar:chowkidar@localhost:5432/chowkidar
TEST_DATABASE_URL=postgresql+psycopg://chowkidar:chowkidar@localhost:5432/chowkidar_test

# Auth
AUTH_MODE=dev
DEV_JWT_SECRET=replace-with-a-random-64-hex-string
DEMO_MODE=true
SUPABASE_URL=
# Legacy anon/service_role JWTs or the new sb_publishable_*/sb_secret_* keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy projects that still sign access tokens with HS256.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=chowkidar-documents
SUPABASE_AUTH_TIMEOUT_SECONDS=15

# Production path (set these in Render/Vercel, never commit real values):
# AUTH_MODE=supabase
# DEMO_MODE=false
# STORAGE_BACKEND=database   # hosted default; supabase is optional
# REPORT_STORAGE_BUCKET=chowkidar-reports
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
MUTATION_RATE_LIMIT_PER_MINUTE=30

# AI
LLM_MODE=mock
DATA_MODE=fixture
EMBEDDING_MODE=mock
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_FLASH_MODEL=gemini/gemini-3.8-flash
GEMINI_PRO_MODEL=gemini/gemini-pro-latest
GROQ_MODEL=groq/openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/qwen2.5:7b

# Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chowkidar-dev
NEO4J_DATABASE=neo4j

# Internal automation
INTERNAL_API_KEY=replace-with-a-random-internal-key
ENABLE_SCHEDULER=false
N8N_API_URL=http://localhost:5678

# Observability and analytics
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Storage and reports
STORAGE_BACKEND=local   # local | database | supabase
REPORT_STORAGE_BUCKET=chowkidar-reports
LOCAL_STORAGE_DIR=./storage
REPORT_STORAGE_DIR=./storage/reports
UPLOAD_STORAGE_DIR=./storage/uploads

# Read-only MCP server (optional)
CHOWKIDAR_API_URL=http://127.0.0.1:8000
CHOWKIDAR_DEMO_ROLE=analyst
CHOWKIDAR_MCP_TOKEN=
